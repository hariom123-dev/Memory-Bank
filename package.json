{
  "name": "memory-bank",
  "version": "0.1.0",
  "description": "Local Agent Swarm Operating System - Memory Orchestration Daemon",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "memory-bank": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "bootstrap": "npm run build && node dist/cli/healthcheck.js",
    "prestart": "node dist/cli/healthcheck.js",
