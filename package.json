    "ora": "^9.4.1",
    "ts-morph": "^28.0.0",
    "xstate": "^5.19.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.13.5",
    "tsup": "^9.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
