# ==============================================================================
# Memory Bank - Environment Configuration
# Copy this file to .env and adjust settings as needed:
#   cp .env.example .env
# ==============================================================================

# Node runtime environment (development | production | test)
NODE_ENV=development

# Logging verbosity (debug | info | warn | error)
LOG_LEVEL=info

# SQLite database file path (relative to workspace or absolute)
MEMORY_BANK_DB_PATH=memory-bank.sqlite

# Workspace root directory to index and watch
MEMORY_BANK_WORKSPACE_ROOT=.

# Transformers.js model identifier for semantic vector embeddings
MEMORY_BANK_MODEL_NAME=Xenova/all-MiniLM-L6-v2

# Maximum grace period (in milliseconds) before forceful daemon termination
MEMORY_BANK_SHUTDOWN_TIMEOUT_MS=5000

